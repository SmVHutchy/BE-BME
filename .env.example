# Kopie als `.env` anlegen und bei Bedarf anpassen.
#
# HIER STEHEN KEINE SECRETS, UND ES WERDEN AUCH KEINE DAZUKOMMEN:
#   - Open-Meteo benoetigt keinen API-Schluessel (Expose 3.5).
#   - LM Studio laeuft lokal; der Schluessel wird nicht geprueft und steht
#     als Platzhalter in config/params.yaml.
# Sollte irgendwann ein echtes Geheimnis noetig werden, gehoert es hierher und
# niemals in params.yaml - jene Datei wird versioniert.
#
# Fachliche Parameter gehoeren NICHT hierher, sondern nach config/params.yaml.
# Diese Datei enthaelt nur, was pro Maschine abweicht.

# Ablageort der Konfiguration, falls abweichend.
FRAME_CONFIG_PATH=config/params.yaml

# Ueberschreibt server.host / server.port aus params.yaml, falls noetig.
# FRAME_HOST=127.0.0.1
# FRAME_PORT=8000

# Log-Ausfuehrlichkeit: DEBUG | INFO | WARNING | ERROR
FRAME_LOG_LEVEL=INFO
